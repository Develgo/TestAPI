meta {
  name: Login (Get Bearer Token)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "tester",
    "password": "password"
  }
}

assert {
  res.status: eq 200
  res.body.token: isDefined
  res.body.tokenType: eq Bearer
}
